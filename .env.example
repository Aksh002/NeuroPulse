# Copy values into your shell environment when overriding local application paths.
# Scientific parameters belong in versioned YAML, not environment variables.
NEUROPULSE_DATA_DIR=data
NEUROPULSE_ARTIFACT_DIR=artifacts/models
NEUROPULSE_RESULTS_DIR=results

# Leave version overrides empty to use results/deployment.json.
NEUROPULSE_RUL_MODEL_VERSION=
NEUROPULSE_ANOMALY_MODEL_VERSION=
NEUROPULSE_FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
